{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2023",
        "strict": true,
        "outDir": "../../target/color_dialog",
        "rootDir": "./src",
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "ES2023"
        ],
        "skipLibCheck": true,
        "pretty": true,
        "removeComments": true,
        "incremental": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "sourceMap": false,
    },
    "include": [
        "src/*.ts",
        "../ambient.d.ts"
    ]
}

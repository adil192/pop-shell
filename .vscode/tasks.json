{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lint all",
            "type": "npm",
            "script": "lint",
            "problemMatcher": "$eslint-stylish",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "never",
                "echo": false,
                "showReuseMessage": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
